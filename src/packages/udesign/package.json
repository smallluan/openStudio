{
  "name": "@open-studio/udesign",
  "version": "0.1.0",
  "description": "UDesign - Open Studio 组件库",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles/css-variables.css": "./src/styles/css-variables.css",
    "./styles/variables.less": "./src/styles/variables.less"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "storybook": "storybook dev -p 6060 --no-open",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.storybook.json",
    "typecheck:src": "tsc --noEmit -p tsconfig.json",
    "typecheck:storybook": "tsc --noEmit -p tsconfig.storybook.json"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "lucide-react": "^1.17.0"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/addon-interactions": "^8.6.18",
    "@storybook/addon-links": "^8.6.18",
    "@storybook/blocks": "^8.6.18",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@types/react": "19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.3.4",
    "less": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^8.6.18",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
