{
  "name": "open-studio",
  "version": "0.1.0",
  "description": "Electron desktop app",
  "main": "main.js",
  "scripts": {
    "dev:vite": "vite",
    "dev:gateway": "cross-env OPENCLAW_ALLOW_OLDER_BINARY_DESTRUCTIVE_ACTIONS=1 node scripts/run-openclaw-gateway.mjs",
    "pack:openclaw": "node scripts/pack-openclaw-asar.mjs",
    "dev:electron": "wait-on http://127.0.0.1:5173 && cross-env NODE_ENV=development electron .",
    "dev": "cross-env NODE_ENV=development concurrently -k -n vite,gateway,electron \"npm:dev:vite\" \"npm:dev:gateway\" \"npm:dev:electron\"",
    "build": "vite build",
    "dist:win": "vite build && node scripts/run-dist-win-electron-builder.cjs",
    "start": "cross-env NODE_ENV=production electron .",
    "preview": "vite preview",
    "openclaw": "openclaw",
    "windows:defender-exclude-openclaw-dev": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/windows-defender-exclude-openclaw-dev.ps1",
    "postinstall": "node scripts/apply-openclaw-memo.mjs && node scripts/patch-openclaw-chat-image-inline.mjs && node scripts/patch-openclaw-studio-lean-chat.mjs && node scripts/generate-openclaw-bundled-skills.mjs"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "build": {
    "appId": "dev.openstudio.app",
    "productName": "Open Studio",
    "copyright": "Copyright © Open Studio contributors",
    "beforePack": "scripts/electron-builder-before-pack.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!src/**/*",
      "!scripts/**/*",
      "!release/**/*",
      "!tmp-pack/**/*",
      "!node_modules/openclaw{,/**}",
      "!**/*.map",
      "!**/builder-debug.yml",
      "!**/.cursor/**/*"
    ],
    "electronLanguages": [
      "en-US",
      "zh-CN"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.{node,dll}",
      "node_modules/openclaw/openclaw.mjs",
      "node_modules/openclaw/dist/**"
    ],
    "win": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "signAndEditExecutable": false,
      "extraResources": [
        {
          "from": "tmp-pack/openclaw.asar",
          "to": "openclaw.asar"
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "differentialPackage": false,
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "concat-map": "0.0.1",
    "@electron/asar": "^4.0.1",
    "@floating-ui/react": "^0.27.19",
    "@tanstack/react-virtual": "^3.13.24",
    "electron-log": "^5.4.4",
    "katex": "^0.16.45",
    "openclaw": "^2026.5.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.14.2",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "electron-builder": "^26.7.1",
    "tailwindcss": "^4.2.4",
    "vite": "^6.0.0",
    "wait-on": "^8.0.0"
  }
}
